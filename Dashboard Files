const CONCEPT_DEFS = {};
function registerConcept(id, title, desc, mkey){
  if(!CONCEPT_DEFS[id]) CONCEPT_DEFS[id] = {title, entries:[]};
  if(!CONCEPT_DEFS[id].entries.some(e=>e.desc===desc)) CONCEPT_DEFS[id].entries.push({module:mkey, desc});
}
