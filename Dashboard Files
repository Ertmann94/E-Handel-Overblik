.weblist-num{width:30px;height:30px;border-radius:50%;background:var(--m6-bg);color:var(--m6);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;flex:none;font-family:"Inter",sans-serif;z-index:1}
.weblist-item.done .weblist-num{background:var(--m6);color:var(--accent-fg)}
.weblist-row{font-family:"Inter",sans-serif;flex:1;min-width:0;display:flex;align-items:center;gap:10px;text-align:left;background:var(--card);border:1px solid var(--card-border);border-radius:12px;padding:13px 14px;margin-bottom:10px;cursor:pointer;color:var(--fg);box-shadow:var(--shadow);position:relative}
.weblist-row:hover{border-color:var(--m6)}
.weblist-item.done .weblist-row{opacity:.62}
.weblist-item.done .weblist-title{text-decoration:line-through}
.weblist-title{flex:1;font-size:14.5px;font-weight:600}
.weblist-arrow{color:var(--fg-dim);flex:none}
.weblist-row[data-tip]:hover::after,.weblist-row[data-tip]:focus-visible::after{content:attr(data-tip);position:absolute;left:0;right:0;top:100%;margin-top:6px;background:var(--fg);color:var(--bg);font-size:12px;font-weight:400;line-height:1.45;padding:9px 11px;border-radius:9px;z-index:6;box-shadow:var(--shadow);white-space:normal}
.manual-head{font-family:"Inter",sans-serif;font-size:15px;margin:24px 0 12px}
.manual-list{padding-left:20px;display:flex;flex-direction:column;gap:11px;font-size:15px;line-height:1.65;margin:0}
.manual-list li{padding-left:4px}
.webstepnav{display:flex;justify-content:space-between;gap:10px;margin-top:14px}
.webstepnav .backbtn{max-width:48%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:inline-block}
.stepdonecheck{display:flex;align-items:center;gap:9px;font-family:"Inter",sans-serif;font-weight:700;font-size:13.5px;margin-bottom:20px;cursor:pointer;color:var(--fg)}
.stepdonecheck input{width:20px;height:20px;accent-color:var(--m6);cursor:pointer}

/* ---- bluish glow on the "Hjemmesiden" tile ---- */
@keyframes tileglow{
  0%,100%{box-shadow:0 0 16px 1px rgba(59,130,246,.35), var(--shadow);}
  50%{box-shadow:0 0 28px 6px rgba(59,130,246,.55), var(--shadow);}
}
.tile-glow{border-color:rgba(59,130,246,.55);animation:tileglow 3.2s ease-in-out infinite}
.tile-glow:hover{animation-play-state:paused;box-shadow:0 0 30px 7px rgba(59,130,246,.6), var(--shadow)}

/* ---- light/dark/auto theme toggle (floating, persists across renders) ---- */
.themebtn{position:fixed;bottom:calc(14px + env(safe-area-inset-bottom,0px));right:16px;z-index:50;font-family:"Inter",sans-serif;font-size:12.5px;font-weight:700;background:var(--card);border:1px solid var(--card-border);color:var(--fg);border-radius:999px;padding:8px 14px;cursor:pointer;box-shadow:var(--shadow)}
.themebtn:hover{border-color:var(--accent);color:var(--accent)}

/* ---- global search (floating, overlay, persists across renders) ---- */
.searchbtn{position:fixed;bottom:calc(14px + env(safe-area-inset-bottom,0px));left:16px;z-index:50;font-family:"Inter",sans-serif;font-size:12.5px;font-weight:700;background:var(--card);border:1px solid var(--card-border);color:var(--fg);border-radius:999px;padding:8px 14px;cursor:pointer;box-shadow:var(--shadow);display:flex;align-items:center;gap:6px}
.searchbtn:hover{border-color:var(--accent);color:var(--accent)}
.searchoverlay{position:fixed;inset:0;background:rgba(20,16,10,.5);z-index:100;display:flex;align-items:flex-start;justify-content:center;padding:68px 16px 16px}
.searchoverlay[hidden]{display:none}
.searchpanel{width:100%;max-width:640px;max-height:76vh;display:flex;flex-direction:column;background:var(--card);border:1px solid var(--card-border);border-radius:16px;box-shadow:var(--shadow);overflow:hidden}
.searchbar{display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--border);font-family:"Inter",sans-serif;flex:none}
.searchbar input{flex:1;min-width:0;border:none;background:transparent;font-size:15px;font-family:"Source Serif Pro",Georgia,serif;color:var(--fg);outline:none}
.searchbar input::placeholder{color:var(--fg-dim)}
.searchclose{background:none;border:none;color:var(--fg-dim);font-size:15px;cursor:pointer;padding:4px;flex:none}
.searchclose:hover{color:var(--fg)}
.searchresults{overflow-y:auto}
.searchgroup-label{font-family:"Inter",sans-serif;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;color:var(--fg-dim);padding:12px 16px 4px}
.searchresult{display:flex;flex-direction:column;gap:2px;width:100%;text-align:left;background:none;border:none;border-top:1px solid var(--border);padding:10px 16px;cursor:pointer;color:var(--fg);font-family:"Inter",sans-serif}
.searchgroup-label + .searchresult{border-top:none}
.searchresult:hover{background:var(--bg-alt)}
.searchresult .srtitle{font-size:14px;font-weight:600}
.searchresult .srmeta{font-size:11.5px;color:var(--fg-dim)}
.searchresult .srsnippet{font-size:12px;color:var(--fg-dim);line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.searchempty{font-family:"Inter",sans-serif;color:var(--fg-dim);font-size:13.5px;padding:26px 16px;text-align:center;line-height:1.6}
.search-flash{animation:searchflash 1.8s ease}
@keyframes searchflash{0%{box-shadow:0 0 0 3px rgba(59,130,246,.65);border-radius:10px}100%{box-shadow:0 0 0 0 rgba(59,130,246,0);border-radius:10px}}

function getThemePref(){ try{ return localStorage.getItem('theme-pref') || 'auto'; }catch(e){ return 'auto'; } }
function setThemePref(p){ try{ localStorage.setItem('theme-pref', p); }catch(e){} applyTheme(p); renderThemeBtn(); }
function applyTheme(p){
  if(p==='light') document.documentElement.setAttribute('data-theme','light');
  else if(p==='dark') document.documentElement.setAttribute('data-theme','dark');
  else document.documentElement.removeAttribute('data-theme');
}
function cycleTheme(){
  const cur = getThemePref();
  setThemePref(cur==='auto' ? 'light' : cur==='light' ? 'dark' : 'auto');
}
function renderThemeBtn(){
  const p = getThemePref();
  const label = p==='auto' ? '🖥️ Auto' : p==='light' ? '☀️ Lys' : '🌙 Mørk';
  let btn = document.getElementById('themebtn');
  if(!btn){
    btn = document.createElement('button');
    btn.id = 'themebtn';
    btn.className = 'themebtn';
    btn.type = 'button';
    btn.onclick = cycleTheme;
    document.body.appendChild(btn);
  }
  btn.textContent = label;
  btn.title = 'Skift mellem lys, mørk og automatisk (system) tilstand';
}
applyTheme(getThemePref());
renderThemeBtn();

// ---------- global søgning (floating knap + overlay, uafhængig af render()) ----------
function scrollToSearchTarget(id){
  let el;
  try{ el = document.querySelector('[data-search-id="'+id+'"]'); }catch(e){ return; }
  if(!el) return;
  try{ el.scrollIntoView({behavior:'smooth', block:'center'}); }catch(e){}
  try{
    el.classList.add('search-flash');
    setTimeout(()=>{ try{ el.classList.remove('search-flash'); }catch(e){} }, 1800);
  }catch(e){}
}
function renderSearchResults(query){
  const results = document.getElementById('searchresults');
  if(!results) return;
  const q = (query||'').trim().toLowerCase();
  if(!q){
    results.innerHTML = `<div class="searchempty">Begynd at skrive for at søge i begreber &amp; teorier, modeller, opgaver og Hjemmesidens skridt.</div>`;
    return;
  }
  const terms = q.split(/\s+/).filter(Boolean);
  const matches = SEARCH_INDEX.filter(e=>terms.every(t=>e.text.includes(t))).slice(0,40);
  if(!matches.length){
    results.innerHTML = `<div class="searchempty">Intet fundet for "${esc(query)}".</div>`;
    return;
  }
  const typeLabel = {begreb:'Begreber & teorier', model:'Modeller', opgave:'Opgaver', skridt:'Hjemmesiden — skridt'};
  const order = ['begreb','model','opgave','skridt'];
  let htm = '';
  order.forEach(ty=>{
    const group = matches.filter(r=>r.type===ty);
    if(!group.length) return;
    htm += `<div class="searchgroup-label">${esc(typeLabel[ty])}</div>`;
    group.forEach(r=>{
      const i = SEARCH_INDEX.indexOf(r);
      htm += `<button class="searchresult" onclick="goSearchResult(${i})">
        <span class="srtitle">${r.icon} ${esc(r.title)}</span>
        <span class="srmeta">${esc(r.meta)}</span>
        ${r.snippet?`<span class="srsnippet">${esc(r.snippet)}</span>`:''}
      </button>`;
    });
  });
  results.innerHTML = htm;
}
function onSearchInput(v){ renderSearchResults(v); }
function goSearchResult(i){
  const r = SEARCH_INDEX[i];
  if(!r) return;
  closeSearch();
  r.go();
}
function openSearch(){
  const ov = document.getElementById('searchoverlay');
  if(ov) ov.hidden = false;
  const inp = document.getElementById('searchinput');
  if(inp){ inp.value=''; inp.focus(); }
  renderSearchResults('');
}
function closeSearch(){
  const ov = document.getElementById('searchoverlay');
  if(ov) ov.hidden = true;
}
function initSearchUI(){
  if(document.getElementById('searchoverlay')) return;
  const overlay = document.createElement('div');
  overlay.id = 'searchoverlay';
  overlay.className = 'searchoverlay';
  overlay.hidden = true;
  overlay.onclick = function(e){ if(e.target===overlay) closeSearch(); };
  overlay.innerHTML = `
    <div class="searchpanel" onclick="event.stopPropagation()">
      <div class="searchbar">
        <span>🔍</span>
        <input id="searchinput" type="text" placeholder="Søg i begreber, teorier, modeller, opgaver og skridt …" oninput="onSearchInput(this.value)" onkeydown="if(event.key==='Escape')closeSearch()">
        <button class="searchclose" type="button" onclick="closeSearch()" aria-label="Luk søgning">✕</button>
      </div>
      <div id="searchresults" class="searchresults"></div>
    </div>
  `;
  document.body.appendChild(overlay);

  const btn = document.createElement('button');
  btn.id = 'searchbtn';
  btn.className = 'searchbtn';
  btn.type = 'button';
  btn.textContent = '🔍 Søg';
  btn.onclick = openSearch;
  document.body.appendChild(btn);

  document.addEventListener('keydown', function(e){
    const tag = document.activeElement && document.activeElement.tagName;
    if(e.key==='/' && tag!=='INPUT' && tag!=='TEXTAREA'){
      e.preventDefault(); openSearch();
    } else if(e.key==='Escape'){
      closeSearch();
    }
  });
}
initSearchUI();

render();
